<% layout("/layouts/boilerplate") %>


  <style>
    #filters {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      margin-top: 1rem;
    }

    .filter-options {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
    }

    .filter {
      text-align: center;
      margin-right: 2rem;
      margin-top: 1rem;
      opacity: 0.7;
      border-bottom: 2px solid transparent;
      transition: all 0.2s ease-in-out;
    }

    .filter:hover, .filter.active-filter {
      opacity: 1;
      cursor: pointer;
      border-bottom: 2px solid black;
    }

    .filter p {
      font-size: 0.8rem;
      margin-bottom: 0.25rem;
    }

    .tax-info {
      display: none;
    }

    .tax-toggle {
      border: 1px solid rgba(0, 0, 0, 0.15);
      border-radius: 1rem;
      padding: 0.5rem 1rem;
      height: 3.25rem;
      margin-left: auto;
      display: flex;
      align-items: center;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
      margin-top: 1rem;
      transition: border-color 0.2s ease-in-out;
    }

    .tax-toggle:hover {
      border-color: rgba(0, 0, 0, 0.3);
    }

    @media (max-width: 767.98px) {
      #filters {
        flex-direction: column;
        align-items: stretch;
        margin-top: 0.5rem;
      }

      .filter-options {
        overflow-x: auto;
        white-space: nowrap;
        flex-wrap: nowrap;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none; /* Firefox */
        -ms-overflow-style: none; /* IE/Edge */
        padding-bottom: 0.5rem;
      }

      .filter-options::-webkit-scrollbar {
        display: none; /* Chrome/Safari */
      }

      .filter {
        margin-right: 1.5rem;
        margin-top: 0.5rem;
        flex-shrink: 0;
      }

      .tax-toggle {
        margin: 0.5rem auto 1rem auto;
        width: fit-content;
      }
    }
  </style>

  <!-- Filters Toggle Button for Mobile -->
  <button class="btn btn-outline-dark d-md-none w-100 mb-2 py-2 d-flex align-items-center justify-content-center gap-2" type="button" data-bs-toggle="collapse" data-bs-target="#filtersCollapse" aria-expanded="false" aria-controls="filtersCollapse" style="border-radius: 10px; font-weight: 600; border-color: #dddddd; font-size: 0.9rem;">
    <i class="fa-solid fa-sliders"></i> Toggle Category Filters
  </button>

  <div class="collapse d-md-block" id="filtersCollapse">
    <div id="filters">
      <div class="filter-options">
        <div class="filter <%= typeof category !== 'undefined' && category === 'Trending' ? 'active-filter' : '' %>" onclick="filterByCategory('Trending')">
        <div>
          <i class="fa-solid fa-fire"></i>
        </div>
        <p>Trending</p>
      </div>

      <div class="filter <%= typeof category !== 'undefined' && category === 'Rooms' ? 'active-filter' : '' %>" onclick="filterByCategory('Rooms')">
        <div>
          <i class="fa-solid fa-bed"></i>
        </div>
        <p>Rooms</p>
      </div>

      <div class="filter <%= typeof category !== 'undefined' && category === 'Iconic Cities' ? 'active-filter' : '' %>" onclick="filterByCategory('Iconic Cities')">
        <div>
          <i class="fa-solid fa-mountain-city"></i>
        </div>
        <p>Iconic Cities</p>
      </div>

      <div class="filter <%= typeof category !== 'undefined' && category === 'Mountains' ? 'active-filter' : '' %>" onclick="filterByCategory('Mountains')">
        <div>
          <i class="fa-solid fa-mountain"></i>
        </div>
        <p>Mountains</p>
      </div>

      <div class="filter <%= typeof category !== 'undefined' && category === 'Castles' ? 'active-filter' : '' %>" onclick="filterByCategory('Castles')">
        <div>
          <i class="fa-brands fa-fort-awesome"></i>
        </div>
        <p>Castles</p>
      </div>

      <div class="filter <%= typeof category !== 'undefined' && category === 'Amazing Pools' ? 'active-filter' : '' %>" onclick="filterByCategory('Amazing Pools')">
        <div>
          <i class="fa-solid fa-person-swimming"></i>
        </div>
        <p>Amazing Pools</p>
      </div>

      <div class="filter <%= typeof category !== 'undefined' && category === 'Camping' ? 'active-filter' : '' %>" onclick="filterByCategory('Camping')">
        <div>
          <i class="fa-solid fa-campground"></i>
        </div>
        <p>Camping</p>
      </div>

      <div class="filter <%= typeof category !== 'undefined' && category === 'Farms' ? 'active-filter' : '' %>" onclick="filterByCategory('Farms')">
        <div>
          <i class="fa-solid fa-tractor"></i>
        </div>
        <p>Farms</p>
      </div>

      <div class="filter <%= typeof category !== 'undefined' && category === 'Arctic' ? 'active-filter' : '' %>" onclick="filterByCategory('Arctic')">
        <div>
          <i class="fa-solid fa-snowflake"></i>
        </div>
        <p>Arctic</p>
      </div>

      <div class="filter <%= typeof category !== 'undefined' && category === 'Domes' ? 'active-filter' : '' %>" onclick="filterByCategory('Domes')">
        <div>
          <i class="fa-solid fa-igloo"></i>
        </div>
        <p>Domes</p>
      </div>

      </div>

      <div class="tax-toggle">
        <div class="form-check-reverse form-switch">
          <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
          <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
        </div>
      </div>
    </div>
  </div>

  <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mt-3">
    <% if (allListings.length === 0) { %>
      <div class="col-12 text-center mt-5">
        <i class="fa-regular fa-face-frown" style="font-size: 3rem; color: #fe424d; margin-bottom: 1rem; display: block;"></i>
        <h3>No listings found</h3>
        <p class="text-muted">Try checking your spelling or searching for a different destination or category.</p>
        <a href="/listings" class="btn btn-dark mt-2">Clear search & filters</a>
      </div>
    <% } else { %>
      <% for(let listing of allListings) { %>
        <a href="/listings/<%=listing._id%>" class="listing-link">
          <div class="card col listing-card">
            <img src="<%= listing.image%>" class="card-img-top" alt="listing_image" style="height: 20rem" />
            <div class="card-img-overlay"></div>
            <div class="card-body">
              <p class="card-text">
                <b>
                  <%= listing.title %>
                </b>
                <br />
                <!-- Mobile Only Metadata -->
                <span class="card-metadata d-md-none text-muted" style="font-size: 0.78rem; display: block; margin-top: 2px; margin-bottom: 2px;">Entire home &bull; 4 guests &bull; 2 beds</span>
                
                &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %> /night
                <i class="tax-info">&nbsp; &nbsp;+18% GST</i>
              </p>
            </div>
          </div>
        </a>
      <% } %>
    <% } %>
  </div>

<script>
  let taxSwitch = document.getElementById("switchCheckDefault");
  
  // Restore switch state from localStorage on page load
  const showTaxes = localStorage.getItem("showTaxes") === "true";
  taxSwitch.checked = showTaxes;
  
  // Function to set visibility of all tax-info elements
  function toggleTaxes(visible) {
    let taxInfo = document.getElementsByClassName("tax-info");
    for(let info of taxInfo){
      info.style.display = visible ? "inline" : "none";
    }
  }
  
  // Set initial state on load
  toggleTaxes(showTaxes);

  taxSwitch.addEventListener("click",()=>{
    const isChecked = taxSwitch.checked;
    localStorage.setItem("showTaxes", isChecked);
    toggleTaxes(isChecked);
  });

  function filterByCategory(category) {
    const urlParams = new URLSearchParams(window.location.search);
    const currentCategory = urlParams.get('category');
    if (currentCategory === category) {
      window.location.href = '/listings';
    } else {
      window.location.href = `/listings?category=${encodeURIComponent(category)}`;
    }
  }
</script>